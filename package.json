{
  "name": "coquimbo-avisos",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:rls": "pnpm --filter web test:rls",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "supabase db push",
    "db:types": "supabase gen types --linked --schema public > apps/web/src/lib/supabase/database.types.ts && prettier --write apps/web/src/lib/supabase/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0"
  }
}
