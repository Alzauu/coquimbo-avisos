# Copia este archivo a apps/web/.env.local y completa los valores.
# Next.js lee las variables desde la carpeta de la app (apps/web), no desde la raíz.
# Nunca pongas aquí la clave service_role de Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

# Solo para `pnpm test:rls`: va en apps/web/.env.test.local, nunca en
# .env.local ni en variables NEXT_PUBLIC_*. Crea y borra usuarios de prueba.
# SUPABASE_SERVICE_ROLE_KEY=
