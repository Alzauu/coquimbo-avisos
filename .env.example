# Copia este archivo a apps/web/.env.local y completa los valores.
# Next.js lee las variables desde la carpeta de la app (apps/web), no desde la raíz.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

# --- Solo servidor: nunca con prefijo NEXT_PUBLIC_ ni en código del navegador ---

# Clave service_role de Supabase: se salta la RLS. ÚNICA excepción a la
# regla de no usarla en la app: la lee solo src/lib/supabase/service-role.ts
# (import "server-only") y solo lo importa el Route Handler de fotos
# públicas (src/app/fotos/[id]/route.ts), para leer archivos del bucket
# privado después de que ruta_foto_publica confirme que la foto es pública.
# ESLint impide importarla o leerla desde cualquier otro archivo. También va
# en apps/web/.env.test.local para `pnpm test:rls`, que crea y borra
# usuarios de prueba. En Vercel, solo como variable de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar las URLs de fotos públicas (HMAC-SHA256). Al menos
# 32 caracteres aleatorios, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Cambiarlo invalida las URLs ya entregadas (duran 10 minutos).
FOTOS_FIRMA_SECRETO=
